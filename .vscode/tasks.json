{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Frontend Terminal",
      "type": "shell",
      "command": "cmd /k cd /d \"${workspaceFolder}\\frontend\"",
      "presentation": {
        "reveal": "always",
        "focus": false,
        "panel": "new",
      }
    },
    {
      "label": "Backend Terminal",
      "type": "shell",
      "command": "cmd /k cd /d \"${workspaceFolder}\\backend\"",
      "presentation": {
        "reveal": "always",
        "focus": false,
        "panel": "new",
      }
    },
    {
      "label": "Open Both Terminals",
      "dependsOn": ["Frontend Terminal", "Backend Terminal"],
      "dependsOrder": "parallel",
      "runOptions": {
        "runOn": "folderOpen"
      }
    }
  ]
}
